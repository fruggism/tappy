# Variabili d'ambiente per le Netlify Functions (backend).
#
# In locale: `npm run setup-env` crea il .env chiedendoti solo il token,
# oppure copia questo file in .env e riempilo a mano.
# In produzione: impostale in Netlify -> Site configuration -> Environment variables.

# Personal Access Token di Airtable (comincia per "pat"), con gli scope
# data.records:read e data.records:write, abilitato SOLO sulla base di tappy.
# Si crea su https://airtable.com/create/tokens — e' un segreto: non finisce
# mai nel repository.
AIRTABLE_API_KEY=

# Id della base Airtable di tappy. Non e' un segreto: senza il token non
# apre niente. Lo si legge nell'URL della base, e' la parte che inizia per "app".
AIRTABLE_BASE_ID=app5U8MT6jT6Ei36q
